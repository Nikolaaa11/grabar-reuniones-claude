{
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Robots-Tag", "value": "noindex" },
      { "key": "X-Content-Type-Options", "value": "nosniff" }
    ] },
    { "source": "/(.*)\\.md", "headers": [ { "key": "Content-Type", "value": "text/markdown; charset=utf-8" } ] },
    { "source": "/(.*)\\.txt", "headers": [ { "key": "Content-Type", "value": "text/plain; charset=utf-8" } ] },
    { "source": "/(.*)\\.skill", "headers": [
      { "key": "Content-Type", "value": "application/zip" },
      { "key": "Content-Disposition", "value": "attachment; filename=\"actas-reunion.skill\"" }
    ] }
  ]
}
